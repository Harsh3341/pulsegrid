{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PulseGrid sanitized test results 1.0.0",
  "type": "array",
  "maxItems": 10000,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "method",
      "outcome",
      "durationMilliseconds",
      "diagnostics"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
      },
      "method": {
        "type": "string",
        "minLength": 1,
        "maxLength": 769
      },
      "outcome": {
        "enum": [
          "passed",
          "failed",
          "skipped",
          "inconclusive"
        ]
      },
      "durationMilliseconds": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      },
      "diagnostics": {
        "enum": [
          null,
          "[REDACTED]"
        ]
      }
    }
  }
}
